{
  "name": "chats",
  "private": true,
  "version": "2.7.0",
  "description": "End-to-end encrypted chat you host yourself: PWA client, admin console and PHP API",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite --mode client",
    "dev:admin": "vite --mode admin",
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs && node scripts/release.mjs",
    "version:set": "node scripts/version.mjs",
    "test:client": "node tests/client-security.mjs",
    "test:api": "node tests/e2e.mjs",
    "test:security": "node tests/security.mjs",
    "tauri": "cd native && tauri",
    "native:build": "npm run build && cd native && tauri build",
    "native:dev": "cd native && tauri dev",
    "native:android": "npm run build && cd native && tauri android build --apk"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@scure/bip39": "^1.6.0",
    "hash-wasm": "^4.12.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}

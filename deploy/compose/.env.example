# Copy to .env next to the compose files and fill in.
# Your domain: Caddy gets a free HTTPS certificate for it automatically. Leave as :80 for plain HTTP
# (localhost, or behind your own reverse proxy).
CHATS_DOMAIN=:80
# Required: the first-run setup wizard only opens with this. Make one with: openssl rand -hex 16
CHATS_SETUP_TOKEN=
# Image tag to run (a release like 2.6.0, or latest).
CHATS_VERSION=latest
# Database password for the postgres / mysql variants.
CHATS_DB_PASS=
# Object storage keys for the s3 overlay.
CHATS_S3_KEY=chats
CHATS_S3_SECRET=
